# Variáveis do Kontra, com valores padrão de DESENVOLVIMENTO — nunca use estas
# credenciais em um ambiente real.
#
# ATENÇÃO: só o docker compose lê o arquivo .env da raiz (fora do git). Copie este
# arquivo para .env para sobrescrever as variáveis das seções "compose". As demais
# seções (Backend, Frontend, e2e) estão aqui apenas como REFERÊNCIA: NÃO são lidas
# do .env — exporte-as no shell (Git Bash: export NOME=valor; PowerShell:
# $env:NOME="valor") ou configure-as na IDE.

# ======================= Lidas pelo docker compose (.env) =======================

# --- Banco (serviço "banco"; nomes impostos pela imagem oficial do PostgreSQL) ---
# Mudar USER/PASSWORD/DB depois da primeira subida NÃO tem efeito: o initdb só roda
# com o volume vazio. Para aplicar, recrie o volume: docker compose down -v
POSTGRES_DB=kontra
POSTGRES_USER=kontra
# Senha só de desenvolvimento
POSTGRES_PASSWORD=kontra

# --- Portas no host ---
# O banco é publicado só em 127.0.0.1.
PORTA_POSTGRES=5432
PORTA_BACKEND=8080
PORTA_FRONTEND=3000

# ============ Referência — NÃO lidas do .env (exporte no shell ou na IDE) ============

# --- Backend (spring-boot:run local; no compose, estes valores são derivados de
#     POSTGRES_*, com host "banco") ---
# Se mudar PORTA_POSTGRES (ou POSTGRES_DB), ajuste a porta/nome em BANCO_URL.
BANCO_URL=jdbc:postgresql://localhost:5432/kontra
BANCO_USUARIO=kontra
# Senha só de desenvolvimento
BANCO_SENHA=kontra
# Opcionais: desligam OpenAPI e Swagger UI (padrão: true)
# SPRINGDOC_API_DOCS_ENABLED=true
# SPRINGDOC_SWAGGER_UI_ENABLED=true

# --- Frontend (só "npm run dev"; lido pelo vite.config.ts) ---
# Se mudar PORTA_BACKEND, ajuste aqui.
DESTINO_PROXY_API=http://localhost:8080

# --- e2e (lido pelo playwright.config.ts) ---
# Se mudar PORTA_FRONTEND, ajuste aqui.
URL_BASE_E2E=http://localhost:3000
